{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "python scripts/release_version.py check ${nextRelease.version}",
        "prepareCmd": "python scripts/release_version.py set ${nextRelease.version} && python -m build"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "pyproject.toml", "plugins/backtest2live/.claude-plugin/plugin.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [{ "path": "dist/*" }],
        "successComment": false,
        "failComment": false
      }
    ]
  ]
}
